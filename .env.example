# Local app only. Copy to job-radar/.env (or backend/.env). Every value is optional.
# The hosted version is configured with GitHub secrets and Vercel env vars instead (see README).

# SQLite file, relative to backend/
DATABASE_URL=sqlite:///./job_radar.db

# Which sources run is set in config/sources.json. This overrides it, e.g. "mock" or "unstop,companies".
ENABLED_SOURCES=

# Automatic scanning for the local app (minimum 5). A scan also runs once at startup.
SCHEDULER_ENABLED=true
SCAN_INTERVAL_MINUTES=15
# Minimum seconds between two manual "Scan now" presses (0 = no limit)
MIN_MANUAL_SCAN_GAP_SECONDS=60

# Mock source only: add one brand-new job on every scan, to test alerts end to end
MOCK_EMIT_NEW_JOB_EACH_SCAN=false

# Alerts: browser (dashboard tab), telegram, or both: "browser,telegram"
NOTIFY_CHANNELS=browser
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_URL=

FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
